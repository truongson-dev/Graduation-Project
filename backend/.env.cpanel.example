# ==============================================================================
# SoftSkill AI - Cấu hình Production trên cPanel Hosting (MySQL)
# Hãy sao chép file này thành .env trên cPanel và cập nhật các thông số phù hợp.
# ==============================================================================

APP_NAME="SoftSkill AI"
APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false

# Nếu dùng Subdomain: https://api.yourdomain.com
# Nếu dùng Single Domain: https://yourdomain.com
APP_URL=https://api.yourdomain.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Cấu hình Cơ sở dữ liệu MySQL trên cPanel
# (Lấy từ: cPanel > MySQL Databases > Tạo Database & Tạo User rồi gán quyền All Privileges)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_dbname
DB_USERNAME=your_cpanel_dbuser
DB_PASSWORD=your_cpanel_mysql_password_here

# ------------------------------------------------------------------------------
# Quản lý Session, Cache & Queue (Sử dụng bảng database để không phụ thuộc Redis)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# QUAN TRỌNG:
# - Nếu dùng subdomain: đặt .yourdomain.com (có dấu chấm ở đầu để chia sẻ cookie giữa api và web)
# - Nếu dùng chung 1 domain: để null
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Mail (Mặc định log, hoặc điền thông tin Email cPanel / SMTP Gmail của bạn)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# CORS & Xác thực Laravel Sanctum SPA
# ------------------------------------------------------------------------------
FRONTEND_URL=https://yourdomain.com
FRONTEND_URLS=https://yourdomain.com,https://api.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SANCTUM_EXPIRATION=15
AUTH_DEFAULT_ROLE=student
AUTH_RESET_URL=https://yourdomain.com/reset-password

# ------------------------------------------------------------------------------
# Google OAuth (Đăng nhập Google)
# Lưu ý thêm Authorized Redirect URI này vào Google Cloud Console:
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/social/google/callback

# ------------------------------------------------------------------------------
# Google Gemini AI SDK
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_CHEAPEST_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# Cloudflare Turnstile anti-bot verification
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_ENABLED=false
